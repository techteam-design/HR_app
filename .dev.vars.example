# Variables the Worker needs at runtime. Names only: never put real values in this file.
#
# Local Workers preview (npm run cf:preview): copy to .dev.vars and fill in.
# Staging / production: set each one with `npx wrangler secret put <NAME>`.
# See .env.example for what each value means.

# Neon POOLED connection string (host contains "-pooler").
DATABASE_URL=

# At least 32 random characters. A different value per environment.
BETTER_AUTH_SECRET=

# The exact origin people open in the browser, no trailing slash.
# cf:preview: http://localhost:8787   Staging: https://hr-app-staging.<subdomain>.workers.dev
BETTER_AUTH_URL=

# Cloudflare R2 (S3 API). Staging uses the sbc-hr-photos-dev bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Shared secret for the cron routes (/api/cron/*): requests must send
# "Authorization: Bearer <CRON_SECRET>". At least 32 random characters
# (anything under 16 is always rejected). The scheduled() handler in
# custom-worker.ts sends it for the daily entitlement job.
CRON_SECRET=

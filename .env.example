# Copy to .env.local (Next.js / drizzle-kit) and .dev.vars (wrangler). Never commit real values.

# Neon POOLED connection string (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL=

# Neon DIRECT (non-pooled) connection string. Used only by drizzle-kit for migrations.
DATABASE_URL_UNPOOLED=

# Better Auth secret: signs session cookies and tokens. At least 32 random characters.
# Use a DIFFERENT value per environment (dev, production). Changing it signs everyone out.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# Better Auth base URL: the exact origin people open in the browser, no trailing slash.
# Local: http://localhost:3000   Production: https://<your-domain>
# Requests from any other origin (e.g. 127.0.0.1 vs localhost) are rejected.
BETTER_AUTH_URL=

# Cloudflare account ID that owns the R2 bucket.
R2_ACCOUNT_ID=

# R2 API token access key ID (scoped to the photo bucket).
R2_ACCESS_KEY_ID=

# R2 API token secret access key.
R2_SECRET_ACCESS_KEY=

# Name of the R2 bucket that stores employee photos.
R2_BUCKET=

# Shared secret that cron requests must send to /api/cron/* routes.
CRON_SECRET=

# ---- Seed scripts (npm run db:seed:admin / db:seed:dev). Not used by the app. ----

# Email of the first admin login (stored lowercased).
SEED_ADMIN_EMAIL=

# Display name of the first admin (also used as the employee's full name).
SEED_ADMIN_NAME=

# Initial password for the first admin, at least 12 characters. They must change it on first login.
# Remove it from the env file after the admin has been created.
SEED_ADMIN_PASSWORD=

# Optional: the admin's real employee code (default ADMIN-001) and join date (YYYY-MM-DD, default today).
# The join date drives leave entitlements, so set it if you know it.
SEED_ADMIN_EMPLOYEE_CODE=
SEED_ADMIN_JOIN_DATE=

# DEV ONLY: shared password (12+ characters) for the dummy logins created by db:seed:dev.
SEED_DEV_PASSWORD=

# DEV ONLY: must be exactly "true" for db:seed:dev to run. NEVER set this in production.
ALLOW_DEV_SEED=

# Copy to .env.local (Next.js / drizzle-kit) and .dev.vars (wrangler). Never commit real values.

# Neon POOLED connection string (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL=

# Neon DIRECT (non-pooled) connection string. Used only by drizzle-kit for migrations.
DATABASE_URL_UNPOOLED=

# Random secret for signing sessions, at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# Base URL of the app, e.g. http://localhost:3000 locally or the production domain.
BETTER_AUTH_URL=

# Cloudflare account ID that owns the R2 bucket.
R2_ACCOUNT_ID=

# R2 API token access key ID (scoped to the photo bucket).
R2_ACCESS_KEY_ID=

# R2 API token secret access key.
R2_SECRET_ACCESS_KEY=

# Name of the R2 bucket that stores employee photos.
R2_BUCKET=

# Shared secret that cron requests must send to /api/cron/* routes.
CRON_SECRET=
